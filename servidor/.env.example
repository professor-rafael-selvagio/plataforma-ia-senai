# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - BACKEND SEGURO OLLAMA
# ==============================================================================

# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta do servidor backend HTTP
PORT=3000

# Porta do frontend web (Interface do usuário no navegador)
FRONTEND_PORT=8080

# Banco de Dados PostgreSQL (Automático no Docker Compose)
# Em produção via Docker: postgresql://postgres:ollama_secure_password_2026@postgres:5432/ollama_db
DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ollama_secure_password_2026
POSTGRES_DB=ollama_db

# Chave secreta para assinatura dos tokens JWT locais
JWT_SECRET=ollama_jwt_super_secret_key_change_me_in_prod

# URL base da API do Ollama
# No Mac local (com túnel SSH ou local): http://localhost:11434
# No ambiente Docker de produção com rede ia-interna: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# Timeout para requisições ao Ollama em milissegundos (padrão: 600000 = 10 minutos)
OLLAMA_TIMEOUT=600000

# Tempo que o modelo permanece carregado na memória RAM/VRAM após a última requisição (padrão: 30m = 30 minutos)
OLLAMA_KEEP_ALIVE=30m

# Origens autorizadas para CORS (use * para permitir qualquer origem ou separe por vírgula)
# Exemplo para produção restrita: http://localhost:5173,http://localhost:8080,http://seu-servidor-interno:8080
ALLOWED_ORIGINS=*

# Lista restrita de modelos autorizados (separados por vírgula)
# Exemplo: llama3:8b,mistral:7b,qwen2.5:7b
# Se deixado em branco, todos os modelos instalados no Ollama são acessíveis
ALLOWED_MODELS=

# Supabase Auth e Banco de Dados (opcional, caso queira usar nuvem Supabase em vez do Postgres local)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Define se a autenticação é estritamente obrigatória em todas as rotas
REQUIRE_AUTH=false

# Limites de requisição (Rate Limit)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20
